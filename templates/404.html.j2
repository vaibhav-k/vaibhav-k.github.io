{% extends "base.html.j2" %}
{% block title %}Page not found — {{ person.name }}{% endblock %}
{% block head_extra %}
        <meta name="robots" content="noindex" />
{% endblock %}
{% block body %}
    <body id="page-top" class="not-found">
        <main class="not-found-main">
            <p class="not-found-code">404</p>
            <h1>Page not found</h1>
            <p class="lead mb-4">That page doesn't exist, but the resume does.</p>
            <a class="btn btn-primary" href="/">{{ icon('arrow') }} Back to the resume</a>
        </main>
    </body>
{% endblock %}
